# Copy to server/.env and fill in JWT_SECRET. Never commit server/.env.
NODE_ENV=development
PORT=4004

# Development database. Do not reuse a database that belongs to another project.
MONGODB_URI=mongodb://127.0.0.1:27017/codsoft_marketplace

# Used only by `npm test`. The test runner refuses any database name except codsoft_marketplace_test.
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/codsoft_marketplace_test

# Required, at least 32 characters, no default exists.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Token and cookie lifetime in hours.
JWT_EXPIRES_IN_HOURS=24

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGINS=http://localhost:5184,http://127.0.0.1:5184

# bcrypt work factor.
BCRYPT_ROUNDS=12

# Maximum login/register attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX=20
