# Copy to server/.env and replace every placeholder. Never commit the copy.
NODE_ENV=development
PORT=4000

# MongoDB connection for the application. The server must be a replica set.
# If your server requires a login, use:
#   mongodb://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:27018/job_portal?replicaSet=rs0&authSource=admin
DATABASE_URL=mongodb://127.0.0.1:27018/job_portal?replicaSet=rs0

# Separate database for automated tests. Its name must contain "test" and differ from the one above.
# The test suite erases this database between tests.
TEST_DATABASE_URL=mongodb://127.0.0.1:27018/job_portal_test?replicaSet=rs0

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRES_IN_HOURS=24

# Comma-separated list of browser origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the API (0 when directly exposed)
TRUST_PROXY_HOPS=0

# Private directory for uploaded resumes, relative to server/
UPLOAD_DIR=uploads/resumes
MAX_RESUME_SIZE_MB=5

# Demo data is refused when NODE_ENV=production unless this is true
ALLOW_DEMO_SEED=false
