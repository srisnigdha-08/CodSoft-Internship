NODE_ENV=development
PORT=5050
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://postgres:password@localhost:5432/dinedesk_db?schema=public

# Security tokens (replace with secure random strings)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret
