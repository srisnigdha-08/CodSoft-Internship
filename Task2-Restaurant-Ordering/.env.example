# DineDesk environment template. Copy to server/.env and fill in real values.
NODE_ENV=development
PORT=5050
# The one browser origin allowed to call the API with credentials (the Vite dev server runs on 3000)
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL connection string for Prisma
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dinedesk_db?schema=public

# Required by "npm test". Must be a separate database with "test" in its name.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/dinedesk_test?schema=public

# Security secrets: replace with long random values. The server refuses to start without them.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
COOKIE_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
