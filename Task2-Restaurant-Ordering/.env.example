# DineDesk Platform — Root Environment Example
# Copy to server/.env and fill in credentials

# Server Configuration
PORT=5050
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL=postgresql://postgres:password@localhost:5432/dinedesk_db?schema=public

# Security Tokens (at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret
