NODE_ENV=development
PORT=5017
FRONTEND_ORIGIN=http://localhost:5173

# MongoDB. Each URI must name its database. Do not point these at a database
# used by another project.
MONGODB_URI=mongodb://localhost:27017/codsoft_student_management
MONGODB_TEST_URI=mongodb://localhost:27017/codsoft_student_management_test

# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Only for the one-time import from the old PostgreSQL database
# (npm run db:migrate:postgres). The running application never uses these.
# LEGACY_PG_HOST=127.0.0.1
# LEGACY_PG_PORT=5432
# LEGACY_PG_DATABASE=codsoft_student_management
# LEGACY_PG_USER=codsoft_sms_app
# LEGACY_PG_PASSWORD=replace_with_the_legacy_database_password
