NODE_ENV=development
PORT=5017
FRONTEND_ORIGIN=http://localhost:5173

# Use a dedicated local application role and database. See the README setup steps.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=codsoft_student_management
DB_USER=codsoft_sms_app
DB_PASSWORD=replace_with_a_local_app_role_password

# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
